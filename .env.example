# Contact form (pages/api/contact.ts) sends mail through Resend: https://resend.com
RESEND_API_KEY=
# Where contact-form messages are delivered (defaults to the email in lib/site.ts)
CONTACT_TO_EMAIL=
# Verified Resend sender (defaults to Resend's test sender, which can only deliver to your own Resend account email)
CONTACT_FROM_EMAIL=
